# Local API (Vite dev proxies /api -> this server)
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=data/kato.db

# Production Docker / VPS — compose.yml sets HOST=0.0.0.0 and DATABASE_PATH=data/ranked.db
# NODE_ENV=production
# CORS_ORIGINS=https://ranked.goodvibes.gg,http://localhost:3000
# SEED_ON_START=1

# Optional: hosted libSQL (only if you want cloud sync — not required)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Frontend build (GitHub Pages / Cloudflare)
# VITE_API_URL=https://api.ranked.goodvibes.gg

# Admin login (API only — set on the VPS, never in the frontend build)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# ADMIN_SESSION_SECRET=long-random-string
